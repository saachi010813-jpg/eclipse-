                        <span class="user-handle" id="sideUserHandle">Saa…chi🥀</span>
                        <span class="user-fullname">Selene ☾</span>
                    </div>
                </div>
                <button class="switch-btn" onclick="openEditProfile()">Switch</button>
            </div>

            <div class="suggestions-header">
                <span class="suggestions-title">Followers for you</span>
                <span class="see-all-btn">See All</span>
            </div>

            <div class="followers-list" id="followersListContainer"></div>
        </div>

    </div>

    <!-- Bottom Navigation Bar (Mobile View) -->
    <div class="bottom-mobile-nav">
        <button class="action-btn-item" onclick="switchView('feed')">🏠</button>
        <button class="action-btn-item" onclick="switchView('reels')">🎬</button>
        <button class="action-btn-item" onclick="switchView('chat')">💬</button>
        <button class="action-btn-item" onclick="openCreateStory()">➕</button>
        <button class="action-btn-item" onclick="switchView('profile')">👤</button>
    </div>

    <!-- Story Viewer Modal -->
    <div class="modal-overlay" id="storyModal">
        <div class="story-modal-card">
            <button class="close-modal-btn" onclick="closeStoryModal()">✕</button>
            <div style="display: flex; align-items: center; gap: 10px;">
                <div class="post-avatar-circle" id="modalStoryAvatar">✨</div>
                <b id="modalStoryUser">@cosmic_star</b>
            </div>
            <div style="font-size: 24px; text-align: center; color: #fff;" id="modalStoryContent">
                Beautiful night sky! 🔭
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <button class="action-btn-item" id="modalStoryLikeBtn" onclick="toggleStoryLike()">🤍</button>
                <small style="color: #ffd700;" id="modalStorySeen">👀 Seen by @cosmic_star</small>
            </div>
        </div>
    </div>

    <!-- JavaScript Application State -->
    <script>
        const state = {
            currentUser: "Saa…chi🥀",
            avatar: "🥀",
            note: "Night vibes 🌙",
            followers: [
                { handle: "@starlight_99", name: "Starlight", dp: "🌟", isFollowing: true },
                { handle: "@eclipse_fan", name: "Eclipse Fan", dp: "🌒", isFollowing: true },
                { handle: "@moon_walker", name: "Moon Walker", dp: "🪐", isFollowing: false },
                { handle: "@galaxy_boy", name: "Galaxy Boy", dp: "🌌", isFollowing: false }
            ],
            stories: [
                { user: "Saa…chi🥀", avatar: "🥀", content: "My Moonlit Story 🌙✨", seen: false, liked: false },
                { user: "@cosmic_star", avatar: "✨", content: "Beautiful night sky! 🔭", seen: false, liked: false },
                { user: "@nebula_dreamer", avatar: "🌌", content: "Exploring galaxies 🌌", seen: false, liked: false },
                { user: "@lunar_girl", avatar: "⭐", content: "Moonlight magic ⭐", seen: true, liked: false }
            ],
            reels: [
                { media: "🌌", user: "@galaxy_boy", caption: "Night aesthetic vibes under the starlight ✨ #eclipse", likes: 12400, liked: true },
                { media: "🩰", user: "@selene_dance", caption: "Midnight ballet practice under the moon 🌙", likes: 8900, liked: false },
                { media: "🔭", user: "@stargazer_me", caption: "Look closely at Saturn's rings tonight! 🪐", likes: 23100, liked: false }
            ],
            currentReelIdx: 0,
            notes: [
                { user: "Saa…chi🥀", avatar: "🥀", note: "Night vibes 🌙" },
                { user: "@cosmic_star", avatar: "✨", note: "Stargazing ✨" },
                { user: "@starlight_99", avatar: "🌟", note: "Dreaming big 🌟" }
            ],
            posts: [
                { id: 1, user: "@astronomy_lover", avatar: "🔭", content: "The full moon tonight looks breathtaking! 🌕✨", likes: 42, liked: false },
                { id: 2, user: "@lunar_art", avatar: "🎨", content: "Just finished painting the Eclipse moon theme! 🎨🌙", likes: 89, liked: false }
            ],
            myPosts: [
                { id: 101, content: "Exploring the moonlit universe with Eclipse! 🌙✨", likes: 12 }
            ],
            activeChatUser: "@cosmic_star",
            chats: {
                "@cosmic_star": [
                    { sender: "@cosmic_star", text: "Hey Saachi! Loving the Eclipse vibe 🌙" },
                    { sender: "Saa…chi🥀", text: "Thank you so much! ✨" }
                ],
                "@starlight_99": [
                    { sender: "@starlight_99", text: "Are you coming for stargazing tonight?" }
                ]
            },
            currentStoryIdx: null
        };

        function init() {
            renderStoriesTray();
            renderNotesTray();
            renderPosts();
            renderFollowersSidebar();
            renderChatsList();
            renderChatMessages();
            renderProfile();
            renderReel();
        }

        function switchView(viewName) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-item-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById('view-' + viewName).classList.add('active');
            const navBtn = document.getElementById('nav-btn-' + viewName);
            if (navBtn) navBtn.classList.add('active');
        }

        function renderReel() {
            const r = state.reels[state.currentReelIdx];
            document.getElementById('reelMediaBox').innerText = r.media;
            document.getElementById('reelUsername').innerText = r.user;
            document.getElementById('reelCaption').innerText = r.caption;
            document.getElementById('reelLikeCount').innerText = r.likes;
            document.getElementById('reelLikeIcon').innerText = r.liked ? '❤️' : '🤍';
        }

        function toggleReelLike() {
            const r = state.reels[state.currentReelIdx];
            r.liked = !r.liked;
            r.likes += r.liked ? 1 : -1;
            renderReel();
        }

        function nextReel() {
            state.currentReelIdx = (state.currentReelIdx + 1) % state.reels.length;
            renderReel();
        }

        function renderStoriesTray() {
            const container = document.getElementById('storiesTrayContainer');
            let html = `
                <div class="story-node" onclick="openCreateStory()">
                    <div class="story-ring-gradient">
                        <div class="story-avatar-inner">${state.avatar}</div>
                        <div class="story-add-badge">+</div>
                    </div>
                    <div class="story-label-text">Your Story</div>
                </div>
            `;

            state.stories.forEach((s, idx) => {
                if (s.user !== state.currentUser) {
                    html += `
                        <div class="story-node" onclick="viewStory(${idx})">
                            <div class="story-ring-gradient ${s.seen ? 'seen' : ''}">
                                <div class="story-avatar-inner">${s.avatar}</div>
                            </div>
                            <div class="story-label-text">${s.user}</div>
                        </div>
                    `;
                }
            });

            container.innerHTML = html;
        }

        function renderNotesTray() {
            const container = document.getElementById('notesTrayContainer');
            let html = '';

            state.notes.forEach(n => {
                html += `
                    <div class="story-node" onclick="selectChat('${n.user}')">
                        <div class="story-ring-gradient seen">
                            <div class="note-bubble-popup">${n.note}</div>
                            <div class="story-avatar-inner">${n.avatar}</div>
                        </div>
                        <div class="story-label-text">${n.user === state.currentUser ? 'Your note' : n.user}</div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function renderPosts() {
            const container = document.getElementById('feedPostsContainer');
            let html = '';

            state.posts.forEach((p, idx) => {
                html += `
                    <div class="post-card">
                        <div class="post-header">
                            <div class="post-user-info">
                                <div class="post-avatar-circle">${p.avatar}</div>
                                <div class="post-username-text">${p.user}</div>
                            </div>
                            <div>•••</div>
                        </div>
                        <div class="post-media-box">${p.avatar}</div>
                        <div class="post-actions-bar">
                            <div class="action-btns-left">
                                <button class="action-btn-item ${p.liked ? 'liked' : ''}" onclick="togglePostLike(${idx})">${p.liked ? '❤️' : '🤍'}</button>
                                <button class="action-btn-item">💬</button>
                                <button class="action-btn-item">✈️</button>
                            </div>
                            <button class="action-btn-item">🔖</button>
                        </div>
                        <div class="post-likes-count">${p.likes} likes</div>
                        <div class="post-caption-box"><b>${p.user}</b>${p.content}</div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function renderFollowersSidebar() {
            const container = document.getElementById('followersListContainer');
            let html = '';

            state.followers.forEach((f, idx) => {
                html += `
                    <div class="follower-item">
                        <div class="follower-info">
                            <div class="follower-dp">${f.dp}</div>
                            <div class="user-names">
                                <span class="user-handle">${f.handle}</span>
                                <span class="user-fullname">${f.name}</span>
                            </div>
                        </div>
                        <button class="follow-action-btn" onclick="toggleFollow(${idx})">${f.isFollowing ? 'Following' : 'Follow'}</button>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function toggleFollow(idx) {
            state.followers[idx].isFollowing = !state.followers[idx].isFollowing;
            renderFollowersSidebar();
        }

        function togglePostLike(idx) {
            const p = state.posts[idx];
            p.liked = !p.liked;
            p.likes += p.liked ? 1 : -1;
            renderPosts();
        }

        function renderChatsList() {
            const container = document.getElementById('chatContactsList');
            let html = '';

            Object.keys(state.chats).forEach(user => {
                html += `
                    <div class="contact-item-row ${user === state.activeChatUser ? 'active' : ''}" onclick="selectChat('${user}')">
                        <div class="contact-dp">👤</div>
                        <div style="font-size: 13px; font-weight: 600;">${user}</div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function selectChat(user) {
            if (!state.chats[user]) {
                state.chats[user] = [];
            }
            state.activeChatUser = user;
            document.getElementById('activeChatUsername').innerText = user;
            renderChatsList();
            renderChatMessages();
            switchView('chat');
        }

        function renderChatMessages() {
            const container = document.getElementById('chatMessagesArea');
            let html = '';

            const msgs = state.chats[state.activeChatUser] || [];
            msgs.forEach(m => {
                const isSent = m.sender === state.currentUser;
                html += `
                    <div class="message-bubble ${isSent ? 'sent' : 'received'}">
                        ${m.text}
                    </div>
                `;
            });

            container.innerHTML = html;
            container.scrollTop = container.scrollHeight;
        }

        function handleChatKeyPress(e) {
            if (e.key === 'Enter') sendChatMessage();
        }

        function sendChatMessage() {
            const input = document.getElementById('chatInputField');
            const text = input.value.trim();
            if (text) {
                state.chats[state.activeChatUser].push({ sender: state.currentUser, text: text });
                input.value = '';
                renderChatMessages();

                setTimeout(() => {
                    state.chats[state.activeChatUser].push({
                        sender: state.activeChatUser,
                        text: "Got it! Loving Eclipse 🌙✨"
                    });
                    renderChatMessages();
                }, 1000);
            }
        }

        function renderProfile() {
            document.getElementById('profileDpIcon').innerText = state.avatar;
            document.getElementById('sideUserDp').innerText = state.avatar;
            document.getElementById('postCount').innerText = state.myPosts.length;
            document.getElementById('followerCount').innerText = state.followers.length;

            const grid = document.getElementById('profileGridContainer');
            let html = '';
            state.myPosts.forEach(() => {
                html += `<div class="grid-post-square">🌙</div>`;
            });
            grid.innerHTML = html;
        }

        function viewStory(idx) {
            state.currentStoryIdx = idx;
            const s = state.stories[idx];
            s.seen = true;

            document.getElementById('modalStoryAvatar').innerText = s.avatar;
            document.getElementById('modalStoryUser').innerText = s.user;
            document.getElementById('modalStoryContent').innerText = s.content;
            document.getElementById('modalStoryLikeBtn').innerText = s.liked ? '❤️' : '🤍';

            document.getElementById('storyModal').classList.add('active');
            renderStoriesTray();
        }

        function closeStoryModal() {
            document.getElementById('storyModal').classList.remove('active');
        }

        function toggleStoryLike() {
            if (state.currentStoryIdx !== null) {
                const s = state.stories[state.currentStoryIdx];
                s.liked = !s.liked;
                document.getElementById('modalStoryLikeBtn').innerText = s.liked ? '❤️' : '🤍';
            }
        }

        function openCreateStory() {
            const storyText = prompt("What's on your story?");
            if (storyText) {
                state.stories.unshift({
                    user: state.currentUser,
                    avatar: state.avatar,
                    content: storyText,
                    seen: false,
                    liked: false
                });
                renderStoriesTray();
                alert("Story posted successfully!");
            }
        }

        function openEditProfile() {
            const newAvatar = prompt("Choose new avatar icon (e.g. 🥀, 🌙, ✨, 🦋):", state.avatar);
            if (newAvatar) {
                state.avatar = newAvatar;
                renderProfile();
                renderStoriesTray();
            }
        }

        init();
    </script>
</body>
</html>

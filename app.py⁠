# --- Helper Function to Render Post ---
def show_post(post, idx):
    post_id = post.get('id', idx)
    post_author = post.get('username', 'User').strip().lower()

    author_profile = st.session_state.user_profiles.get(post_author, {})
    is_private = author_profile.get("is_private", False)
    
    followers = st.session_state.follows.get(post_author, set())
    is_following = current_logged_user.lower() in followers
    is_own_post = (post_author == current_logged_user.lower())

    with st.container(border=True):
        col1, col2, col3 = st.columns([3, 1.5, 1])
        
        with col1:
            privacy_icon = "🔒 " if is_private else "🌐 "
            st.markdown(f"### {privacy_icon}👤 @{post.get('username', 'User')}")

        with col2:
            if not is_own_post:
                btn_txt = "✓ Following" if is_following else "➕ Follow"
                if st.button(btn_txt, key=f"fol_{post_id}_{idx}"):
                    user_followers = st.session_state.follows.setdefault(post_author, set())
                    if is_following:
                        user_followers.remove(current_logged_user.lower())
                    else:
                        user_followers.add(current_logged_user.lower())
                        log_msg = f"✨ @{current_logged_user} started following @{post_author}!"
                        st.session_state.notification_logs.append(log_msg)
                    st.rerun()

        with col3:
            if is_own_post:
                if st.button("🗑️", key=f"del_{post_id}_{idx}"):
                    st.session_state.posts = [p for p in st.session_state.posts if p.get('id') != post_id]
                    if post_id in st.session_state.saved_posts:
                        st.session_state.saved_posts.remove(post_id)
                    st.rerun()

        if is_private and not is_following and not is_own_post:
            st.warning("🔒 **Private Account:** Follow this user to see their posts and photos.")
            return

        if post.get("image") is not None:
            st.image(post["image"], use_container_width=True)

        if post.get("caption"):
            st.write(post["caption"])

        btn_col1, btn_col2, btn_col3 = st.columns([1, 1, 1])
        
        is_liked = post.get("liked", False)
        likes_count = post.get("likes", 0)
        btn_label = "❤️ Liked" if is_liked else "🤍 Like"

        with btn_col1:
            if st.button(f"{btn_label} ({likes_count})", key=f"like_{post_id}_{idx}"):
                post["liked"] = not is_liked
                post["likes"] = likes_count + 1 if post["liked"] else max(0, likes_count - 1)
                st.rerun()

        is_saved = post_id in st.session_state.saved_posts
        save_label = "🔖 Saved" if is_saved else "🏷️ Save"

        with btn_col2:
            if st.button(f"{save_label}", key=f"save_{post_id}_{idx}"):
                if is_saved:
                    st.session_state.saved_posts.remove(post_id)
                else:
                    st.session_state.saved_posts.append(post_id)
                st.rerun()

        with btn_col3:
            show_share = st.button("✈️ Send", key=f"share_btn_{post_id}_{idx}")

        if f"share_open_{post_id}_{idx}" not in st.session_state:
            st.session_state[f"share_open_{post_id}_{idx}"] = False

        if show_share:
            st.session_state[f"share_open_{post_id}_{idx}"] = not st.session_state[f"share_open_{post_id}_{idx}"]

        if st.session_state[f"share_open_{post_id}_{idx}"]:
            with st.expander("✈️ Send Post to Friends", expanded=True):
                following_list = [
                    target for target, followers in st.session_state.follows.items()
                    if current_logged_user.lower() in followers
                ]
                
                if not following_list:
                    st.info("You are not following anyone yet.")
                else:
                    selected_friend = st.selectbox("Select friend to send:", following_list, key=f"sel_{post_id}_{idx}")
                    custom_msg = st.text_input("Message (optional):", key=f"msg_txt_{post_id}_{idx}")
                    
                    if st.button("Send Message 🚀", key=f"send_act_{post_id}_{idx}"):
                        msg_body = f"Shared a post: {post.get('caption', 'Check this out!')}"
                        if custom_msg.strip():
                            msg_body += f" - '{custom_msg.strip()}'"
                            
                        st.session_state.messages.append({
                            "sender": current_logged_user,
                            "receiver": selected_friend.lower().strip(),
                            "text": msg_body
                        })
                        st.success(f"Post sent to @{selected_friend}! ✈️")
                        st.session_state[f"share_open_{post_id}_{idx}"] = False
                        st.rerun()

        st.markdown("---")
        st.markdown("💬 **Comments**")
        comments = post.get("comments", [])
        for c in comments:
            st.info(c)
            
        c_text = st.text_input("Write a comment...", key=f"c_in_{post_id}_{idx}", placeholder="Type here...")
        if st.button("Post Comment", key=f"c_btn_{post_id}_{idx}"):
            if c_text.strip():
                if "comments" not in post:
                    post["comments"] = []
                post["comments"].append(c_text.strip())
                st.rerun()


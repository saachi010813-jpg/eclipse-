                        st.rerun()

                with r_col2:
                    if st.button("🔄 Repost Reel", key=f"repost_btn_{r_idx}"):
                        reposted_reel = {
                            "username": reel["username"],
                            "video": reel["video"],
                            "caption": reel["caption"],
                            "likes": 0,
                            "liked": False,
                            "reposted_by": current_logged_user

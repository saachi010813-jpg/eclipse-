            img_bytes = up_img.getvalue() if up_img else None
            new_p = {
                "id": st.session_state.next_post_id,
                "username": u_name.strip(),
                "caption": u_cap.strip(),
                "image": img_bytes,
                "likes": 0,
                "liked": False,
                "comments": []
            }
            st.session_state.posts.insert(0, new_p)
            st.session_state.next_post_id += 1
            st.success("Post published on Eclipse! 🎉")

